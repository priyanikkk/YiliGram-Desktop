+// Material 3 switch: a filled track, a small outlined thumb when off
+// and a larger one on the accent color when on.
+void ToggleView::paintMaterial(
+		QPainter &p,
+		int left,
+		int top,
+		int outerWidth) {
+	PainterHighQualityEnabler hq(p);
+	const auto toggled = currentAnimationValue();
+	const auto height = _st->diameter + 2 * _st->border;
+	const auto width = _st->diameter + _st->width + 2 * _st->border;
+	const auto line = std::max(_st->border, 1);
+	const auto track = QRectF(style::rtlrect(
+		left,
+		top,
+		width,
+		height,
+		outerWidth)).marginsRemoved(
+			{ line / 2., line / 2., line / 2., line / 2. });
+	const auto radius = track.height() / 2.;
+
+	auto pen = anim::pen(_st->untoggledFg, _st->toggledFg, toggled);
+	pen.setWidthF(line);
+	p.setPen(pen);
+	p.setBrush(anim::brush(_st->untoggledBg, _st->toggledFg, toggled));
+	p.drawRoundedRect(track, radius, radius);
+
+	const auto offSize = height * 0.5;
+	const auto onSize = height * 0.72;
+	const auto size = offSize + (onSize - offSize) * toggled;
+	const auto from = left + height / 2.;
+	const auto till = left + width - height / 2.;
+	auto x = from + (till - from) * toggled;
+	if (style::RightToLeft()) {
+		x = outerWidth - x;
+	}
+	const auto y = top + height / 2.;
+	p.setPen(Qt::NoPen);
+	p.setBrush(anim::brush(_st->untoggledFg, _st->toggledBg, toggled));
+	p.drawEllipse(QPointF(x, y), size / 2., size / 2.);
+}
